# Security
SECRET_KEY=replace-this-with-a-secure-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL=sqlite:///./mock_interview.db

# Storage Limits
MAX_FILE_SIZE_MB=10

# AI Services (For Future Steps)
GEMINI_API_KEY=your_gemini_api_key_here

# Email / Gmail SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=YOUR_GMAIL_ADDRESS
SMTP_PASSWORD=YOUR_GMAIL_APP_PASSWORD
SMTP_FROM_EMAIL=YOUR_GMAIL_ADDRESS
